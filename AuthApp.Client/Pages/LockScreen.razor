@page "/lockscreen"
@inject LoginAttemptTracker AttemptTracker
@inject NavigationManager Navigation

<PageTitle>Account Locked</PageTitle>

<div class="auth-card">
    <div class="auth-icon danger">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
    </div>
    <h3>Account Locked</h3>
    <p class="auth-subtitle">
        You've exceeded the maximum number of login attempts. Please restart the
        application to try again.
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        // Guards against reaching this page any other way than the real lockout path
        // (e.g. typing the URL directly) so the message shown always matches reality.
        Navigation.EnsureOr(AttemptTracker.IsLockedOut, "/");
    }
}
